@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model Ataa.Models.Projects

@{
    Layout = "_Layout";
    ViewData["Title"] = "حذف المشروع";

    var userRole = HttpContextAccessor.HttpContext.Session.GetString("Role") ?? "";
    bool isAdmin = userRole.Equals("Admin", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تأكيد حذف المشروع - جمعية البيئة</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --text-green: #3d5a37;
            --main-green: #2d4d22;
            --danger-red: #c62828;
            --sidebar-gradient: linear-gradient(to bottom, #ffffff, #d7e6d2);
            --bg-light: #f8faf9;
        }

        body {
            background-color: var(--bg-light);
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .main-wrapper {
            flex: 1;
            padding: 40px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .delete-card {
            background: white;
            padding: 40px;
            border-radius: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            max-width: 550px;
            width: 100%;
            text-align: center;
            border-top: 6px solid var(--danger-red);
        }

        .warning-icon {
            font-size: 4rem;
            color: var(--danger-red);
            margin-bottom: 15px;
        }

        .project-preview {
            background: #fdf8f8;
            border-radius: 15px;
            padding: 20px;
            margin: 25px 0;
            text-align: right;
            border: 1px solid #fee;
        }

        .btn-confirm {
            background-color: var(--danger-red);
            color: white;
            border-radius: 30px;
            padding: 12px 30px;
            font-weight: bold;
            width: 100%;
            border: none;
            transition: 0.3s;
        }

            .btn-confirm:hover {
                background-color: #a52323;
                transform: scale(1.02);
                color: white;
            }

      
    </style>
</head>
<body>

    <div class="main-wrapper">
        <div class="delete-card">
            <div class="warning-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <h3 class="fw-bold">تأكيد حذف المشروع</h3>
            <p class="text-secondary">
                هل أنت متأكد من رغبتك في حذف هذا المشروع؟
                <br>
                <small class="text-danger">سيتم حذف كافة بيانات المشروع والتبرعات المرتبطة به نهائياً.</small>
            </p>

            <div class="project-preview">
                <div class="fw-bold text-dark fs-5 mb-1">@Model.Name</div>
                <div class="text-muted">
                    <i class="bi bi-building ms-1"></i> الجهة المنظمة: @Model.OrganizingEntity
                </div>
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-confirm mb-3 shadow-sm">
                    <i class="bi bi-trash3-fill ms-1"></i> تأكيد الحذف النهائي
                </button>

                <a asp-action="Index" class="text-decoration-none text-secondary d-block">
                    <i class="bi bi-arrow-right"></i> تراجع والعودة للقائمة
                </a>
            </form>
        </div>
    </div>

  

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>