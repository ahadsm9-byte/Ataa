@model IEnumerable<Ataa.Models.EventRegistrations>

@{
    ViewData["Title"] = "إدارة حضور المتطوعين";
}

<div class="container mt-5" dir="rtl" style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 style="color: #2d4d22; font-weight: bold;">إدارة حضور المتطوعين</h2>
            <p class="text-muted">الفعالية: <strong style="color: #2d4d22;">@ViewBag.EventName</strong></p>
        </div>

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary rounded-pill px-4" style="background-color: #d4a373; border:none; display: flex; align-items: center; gap: 8px;" onclick="checkSelectionBeforeOpen()">
                <i class="bi bi-patch-check-fill"></i>
                <span>إصدار شهادات للمحددين</span>
            </button>

            <a asp-action="Scanner" asp-route-eventId="@ViewBag.EventId" class="btn btn-dark rounded-pill px-4" style="background-color: #2d4d22; border:none; display: flex; align-items: center; gap: 8px;">
                <i class="bi bi-qr-code-scan"></i>
                <span>فتح واجهة السكان</span>
            </a>

            <a asp-action="EmployeeEventsIndex" class="btn btn-outline-success rounded-pill px-4" style="display: flex; align-items: center; gap: 8px;">
                <i class="bi bi-arrow-right"></i>
                <span>العودة للقائمة</span>
            </a>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3 px-2">
        <span class="fw-bold" style="color: #2d4d22;">قائمة المتطوعين (@(Model?.Count() ?? 0))</span>
        <button type="button" class="btn btn-sm btn-link text-success p-0 fw-bold text-decoration-none" onclick="selectAll(this)">تحديد الكل</button>
    </div>

    <div class="card shadow-sm border-0" style="border-radius: 20px; overflow: hidden;">
        <table class="table table-hover mb-0 text-center">
            <thead style="background-color: #2d4d22; color: white;">
                <tr>
                    <th class="py-3" style="width: 50px;">إختيار</th>
                    <th class="py-3">اسم المتطوع</th>
                    <th class="py-3">رقم الجوال</th>
                    <th class="py-3">حالة الحضور</th>
                    <th class="py-3">تاريخ التسجيل</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var reg in Model)
                    {
                        <tr>
                            <td class="align-middle">
                                <input type="checkbox" value="@reg.Id" class="vol-check-box" style="width: 18px; height: 18px; accent-color: #2d4d22;">
                            </td>
                            <td class="align-middle fw-bold">@(reg.Volunteer?.Name ?? "غير معروف")</td>
                            <td class="align-middle">@(reg.Volunteer?.Phone ?? "---")</td>
                            <td class="align-middle">
                                @if (reg.AttendanceStatus == "تم الحضور" || (reg.AttendanceStatus != null && reg.AttendanceStatus.ToLower() == "attended"))
                                {
                                    <span class="badge rounded-pill bg-success px-3 py-2" style="font-size: 0.85rem; min-width: 100px;">
                                        <i class="bi bi-check-circle-fill ms-1"></i> تم الحضور
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-light text-secondary border px-3 py-2" style="font-size: 0.85rem; min-width: 100px;">
                                        <i class="bi bi-clock-history ms-1"></i> لم يحضر بعد
                                    </span>
                                }
                            </td>
                            <td class="align-middle text-muted">@reg.RegistrationDate.ToString("yyyy/MM/dd")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="certModal" tabindex="-1" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 15px;">
            <div class="modal-header" style="background-color: #2d4d22; color: white; border-radius: 15px 15px 0 0;">
                <h5 class="modal-title fw-bold">إصدار الشهادات للمحددين</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" style="margin-left: 0; margin-right: auto;"></button>
            </div>
            <div class="modal-body p-4 text-end">
                <div class="mb-3">
                    <label class="form-label fw-bold" style="color: #2d4d22;">اسم المشرف</label>
                    <input type="text" id="modalSupervisor" class="form-control text-end" placeholder="مثلاً: أ. أحمد علي">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold" style="color: #2d4d22;">التوقيع اليدوي</label>
                    <div style="border: 2px dashed #d4a373; border-radius: 10px; background: #fafafa; position: relative;">
                        <canvas id="signature-pad" width="450" height="200" style="touch-action: none; cursor: crosshair; width: 100%;"></canvas>
                    </div>
                    <div class="text-start mt-2">
                        <button type="button" class="btn btn-sm btn-link text-danger p-0 fw-bold text-decoration-none" onclick="clearSignature()">
                            <i class="bi bi-eraser-fill"></i> مسح التوقيع
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 justify-content-center pb-4">
                <button type="button" class="btn btn-light px-4 rounded-pill" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-success px-4 rounded-pill" style="background-color: #2d4d22;" onclick="submitCertificates()">إصدار الآن</button>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<style>
    .table td {
        vertical-align: middle;
        padding: 15px !important;
    }

    .btn-outline-success {
        color: #2d4d22;
        border-color: #2d4d22;
    }

    .badge {
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .vol-check-box {
        cursor: pointer;
    }

    #signature-pad {
        border-radius: 10px;
    }
</style>

<script>
    let canvas = document.getElementById('signature-pad');
    let ctx = canvas.getContext('2d');
    let drawing = false;

    ctx.strokeStyle = "#2d4d22";
    ctx.lineWidth = 3;
    ctx.lineCap = "round";

    function getPos(e) {
        let rect = canvas.getBoundingClientRect();
        let clientX = e.touches ? e.touches[0].clientX : e.clientX;
        let clientY = e.touches ? e.touches[0].clientY : e.clientY;
        return { x: clientX - rect.left, y: clientY - rect.top };
    }

    function startDrawing(e) { drawing = true; ctx.beginPath(); let pos = getPos(e); ctx.moveTo(pos.x, pos.y); }
    function draw(e) {
        if (!drawing) return;
        if(e.touches) e.preventDefault();
        let pos = getPos(e);
        ctx.lineTo(pos.x, pos.y);
        ctx.stroke();
    }
    function stopDrawing() { drawing = false; }

    canvas.addEventListener("mousedown", startDrawing);
    canvas.addEventListener("mousemove", draw);
    canvas.addEventListener("mouseup", stopDrawing);
    canvas.addEventListener("touchstart", startDrawing, {passive: false});
    canvas.addEventListener("touchmove", draw, {passive: false});
    canvas.addEventListener("touchend", stopDrawing);

    function clearSignature() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
    }

    function selectAll(btn) {
        const checkboxes = document.querySelectorAll('.vol-check-box');
        const allChecked = Array.from(checkboxes).every(cb => cb.checked);
        checkboxes.forEach(cb => cb.checked = !allChecked);
        btn.innerText = allChecked ? "تحديد الكل" : "إلغاء التحديد";
    }

    function checkSelectionBeforeOpen() {
        const selectedCount = document.querySelectorAll('.vol-check-box:checked').length;
        if (selectedCount === 0) {
            alert("يرجى اختيار متطوع واحد على الأقل من القائمة.");
            return;
        }
        var modalElement = document.getElementById('certModal');
        var modalInstance = new bootstrap.Modal(modalElement);
        modalInstance.show();
    }

    function submitCertificates() {
        const selectedIds = Array.from(document.querySelectorAll('.vol-check-box:checked'))
                                 .map(cb => parseInt(cb.value));

        const supervisor = document.getElementById('modalSupervisor').value.trim();
        const signatureImage = canvas.toDataURL("images/signature.jpg");

        const blank = document.createElement('canvas');
        blank.width = canvas.width;
        blank.height = canvas.height;

        if (!supervisor) {
            alert("يرجى إدخال اسم المشرف.");
            return;
        }

        if (signatureImage === blank.toDataURL()) {
            alert("يرجى وضع التوقيع أولاً.");
            return;
        }

        const formData = new URLSearchParams();
        formData.append('eventId', '@ViewBag.EventId');
        formData.append('supervisorName', supervisor);
        formData.append('AddSignature', signatureImage);
        selectedIds.forEach(id => formData.append('selectedVolunteers', id));

        fetch('/Events/IssueCertificates', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: formData.toString()
        }).then(response => {
            if (response.ok || response.redirected) {
                alert("تمت العملية بنجاح!");
                location.reload();
            } else {
                alert("حدث خطأ أثناء الإصدار.");
            }
        }).catch(err => {
            alert("فشل الاتصال بخادم النظام.");
        });
    }
</script>