@model dynamic
@{
    Layout = "~/Views/Shared/_homeLayout1.cshtml";

}

<style>
    .sidebar, #sidebar-wrapper, .main-sidebar, .sidebar-container, .nav-menu-container {
        display: none !important;
    }

    .main-wrapper, .content-wrapper, #page-content-wrapper, main, .body_container, .inner {
        margin-right: 0 !important;
        margin-left: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .testimonials-page-container {
        background-color: #f8faf7;
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        font-family: 'Segoe UI', sans-serif;
        padding-bottom: 50px;
    }

    .testimonial-card-horizontal {
        background: white;
        border-radius: 25px;
        border: 1px solid #eef2ed;
        position: relative;
        z-index: 5;
        box-shadow: 0 15px 35px rgba(0,0,0,0.03);
        overflow: hidden;
        margin-top: 20px;
        max-width: 1100px;
        margin-left: auto;
        margin-right: auto;
    }

    .author-side {
        background: linear-gradient(135deg, #2d4d22 0%, #1e3317 100%);
        padding: 40px;
        color: white;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        position: relative;
        z-index: 10;
    }

    .author-photo {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        border: 6px solid rgba(212, 175, 55, 0.6);
        object-fit: cover;
        margin-bottom: 20px;
        background: #fff;
        box-shadow: 0 0 20px rgba(0,0,0,0.2);
    }

    .article-side {
        padding: 50px;
        line-height: 2;
        color: #444;
        text-align: justify;
        position: relative;
    }

    .inner-watermark {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0.08; 
        pointer-events: none;
        z-index: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
    }

        .inner-watermark img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: grayscale(100%) brightness(1.1); 
        }

    .article-content-wrapper {
        position: relative;
        z-index: 2;
    }

    .quote-icon {
        font-size: 3.5rem;
        color: #d4af37;
        opacity: 0.15;
        position: absolute;
        top: 20px;
        right: 30px;
        z-index: 3;
    }

    .article-title {
        color: #2d4d22;
        font-weight: 800;
        font-size: 1.3rem;
        margin-bottom: 20px;
        border-bottom: 2px solid #f4ae33;
        display: inline-block;
        padding-bottom: 5px;
    }

    .article-body {
        font-size: 1.1rem;
        margin-bottom: 25px;
    }

    .source-tag {
        background: #f8faf7;
        border-right: 5px solid #d4af37;
        padding: 10px 20px;
        font-weight: bold;
        color: #2d4d22;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }
</style>

<div class="testimonials-page-container rtl" dir="rtl">

    <div class="container py-5">
        <div class="text-center mb-5">
            <h2 style="color: #2d4d22; font-weight: 800;">قالوا عنا</h2>
            <div style="width: 60px; height: 3px; background: #d4af37; margin: 0 auto;"></div>
        </div>

        <div class="testimonial-card-horizontal">
            <div class="row g-0">
                <div class="col-lg-4 author-side">
                    <img src="https://www.madinah-eco.org.sa/rafed/uploads/website_testimonials/66cf90e72063b.png" class="author-photo" alt="عبدالله الجميلي">
                    <h3 class="fw-bold mb-1">أ.عبدالله الجميلي</h3>
                    <p class="text-white-50">كاتب وصحفي</p>
                </div>

                <div class="col-lg-8 article-side">
                    <div class="inner-watermark">
                        <img src="/images/madinah_watermark.jpg" alt="Watermark">
                    </div>

                    <div class="article-content-wrapper">
                        <i class="fas fa-quote-right quote-icon"></i>
                        <h4 class="article-title">"الرسالة المقدسة لجمعية البيئة بالمدينة المنورة"</h4>

                        <div class="article-body">
                            رغم العمر القصير لـ(هذه الجمعية الرائدة)الإ أنها قدَّمت مشروعات وبرامج ومبادرات وفعاليات نوعية في المدينة النبوية،فمن منجزاتها خلال الأشهر القليلة الماضية فقط: ( إطلاق 200 فعالية، منها: تنظيم 62 حملة للتنظيف وإماطة الأذى عن الطرق والميادين والشواطئ، وتنفيذ 88 حملة تشجير لغرس نحو 8000 شجرة، فيما نجحت الجمعية في إقامة ما يزيد على 50 من الملتقيات والمحاضرات والورش التوعوية والتدريبية، واستقطاب أكثر من 10000 متطوع ساهموا بـ 17710 ساعة تطوعية، وهناك المشاركات الإعلامية التثقيفية، والعديد من الشراكات التكاملية مع مختلف القطاعات ذات العلاقة). تلكم هي (جمعية البيئة بالمدينة المنورة) التي تحمل راية رؤية طموحة شعارها (بيئة طيّبة مستدامة بهوية إسلامية)؛ وإيصال رسالتها في توعية المجتمع لاتباع هدي الرسول صلى الله عليه وسلم في حماية البيئة والمحافظة على مواردها، والسعي لجذب و إعداد متطوعين متخصصين، وتحقيق أهدافها الإستراتيجية التي من عناوينها: (تعزيز ثقافة حماية البيئة والمحافظة على استدامتها في شرايين المجتمع، وصناعة برامج تأهيلية وكوادر متميزة مع تمكين المتطوعين، والمشاركة في تطبيق القوانين في هذا الميدان، وكذا دعم استراتيجيات الإصحاح البيئي والحماية البيئية للعاملين، يضاف لذلك حرص الجمعية على التميُّز المؤسسي، وتنمية مواردها بما يضمن ديمومة عطائها).هذا ولأن طموحات (الجمعية) لا حدود لها في تحقيق مستهدفاتها النبيلة، فهي تنفذ أو تعمل على تنفيذ العديد من المشروعات المبتكرة، ومنها مشاريع: (تشجير «السدرة» التابعة لمركز المس يجيد على طريق المدينة ينبع، ومشروع تدوير مخلفات النخيل و الإفادة منها بيئياً وتنموياً واقتصادياً، ومشروع توفير منتجات صديقة للبيئة، وكذلك تشجير وتنطيف الأماكن العامة والسياحية والشواطئ في منطقة المدينة وحمايتها والمساهمة في تأهيلها، ومشروع اكرام النعمة الذي يحفظ فائض الطعام ويستثمره.. أيضاً هناك مشروع وقف النخيل، والمزيد من برامج التوعية والتثقيف والتدريب، الى غير ذلك من المشروعات والمبادرات).تلك اطلالة سريعة على ملف (جمعية البيئة بالمدينة المنورة) التي قدمت الكثير لجدمة البيئة في عاصمة الإسلام الأولى وسيدة المدائن رغم التحديات وعمرها القصير؛ فالشكر كله لمجلس إدارة الجمعية الذي يرأسه الدكتور طه هاشم رشيد، و لإدارتها التنفيذية التي يقودها الأستاذ أحمد بن عبداللطيف المغيدي؛ وهذه دعوة للشركات ورجال الأعمال ومختلف أطياف المجتمع لدعم الجمعية مالياً ولوجستياً ورعاية لمشروعاتها وبرامجها؛ فهي والله تستحق؛ لأنها تسهر على مهمة عظيمة، وهي المحافظة على البيئة وحمايتها في مساراتها كافة بمدينة رسول الله صلى الله عليه وسلم، وتلك المهمة المقدسة، اضافة لأبعادها الدينية والقيمية والمجتمعية والصحية، هناك مواكبتها لرؤية المملكة 2030م في صناعة السعودية
                            االخضراء، وتحقيق جودة الحياة للمجتمع.
                        </div>

                        <div class="source-tag">
                            <i class="far fa-newspaper"></i>
                            <span>تم النشر في جريدة المدينة - 18 فبراير 2023</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
