@model dynamic
@{
    Layout = "~/Views/Shared/_homeLayout1.cshtml";

}

<style>
    .sidebar, #sidebar-wrapper, .main-sidebar {
        display: none !important;
    }

    .main-wrapper, .content-wrapper, main {
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .page-full-bg {
        background: linear-gradient(rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.85)), url('/images/madinah-haram.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
        padding: 40px 20px;
        display: flex;
        flex-direction: column;
        align-items: center; 
        justify-content: flex-start; 
    }

    .image-frame {
        background: white;
        padding: 20px;
        border-radius: 20px;
        box-shadow: 0 15px 50px rgba(0,0,0,0.1);
        border: 1px solid #eef2ed;
        max-width: 1100px;
        width: 100%;
        text-align: center;
        margin-top: 20px; 
    }

    .org-image {
        width: 100%;
        height: auto;
        border-radius: 10px;
        image-rendering: -webkit-optimize-contrast;
    }

</style>

<div class="page-full-bg">

    <div class="image-frame">
        <img src="https://www.madinah-eco.org.sa/rafed/uploads/website_editor/6892d71a029e08.89441196.png"
             alt="الهيكل التنظيمي لجمعية البيئة"
             class="org-image">
    </div>
