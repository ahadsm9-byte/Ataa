<div class="container text-end" style="max-width: 600px; padding-top: 30px;">
    <a href="@Url.Action("EmployeeEventsIndex", "Events")"
       class="text-decoration-none mb-3 d-inline-block"
       style="color: #2d4d22; font-weight: bold;">
        <i class="fas fa-arrow-right ms-1"></i> العودة لقائمة الفعاليات
    </a>

    <div class="card shadow-lg border-0" style="border-radius: 20px;">
        <div class="card-header text-center" style="background: #2d4d22; color: white;">
            <h4 class="mb-0">نظام تحضير المتطوعين</h4>
        </div>

        <div class="card-body">
            <div id="reader" style="width: 100%;"></div>

            <div id="scan-result" class="mt-4 text-center" style="display:none;">
                <h5>اسم المتطوع:</h5>
                <h3 id="volunteer-name" class="text-success"></h3>

                <button id="confirm-btn"
                        class="btn w-100 mt-3"
                        style="background:#2d4d22; color:white;">
                    تأكيد الحضور
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/html5-qrcode"></script>

<script>
    let currentRegId = 0;

    const scanner = new Html5QrcodeScanner("reader", {
        fps: 10,
        qrbox: { width: 250, height: 250 }
    });

    scanner.render((decodedText) => {
        const regIdMatch = decodedText.match(/\d+/);

        if (regIdMatch) {
            currentRegId = parseInt(regIdMatch[0]);

            const urlParams = new URLSearchParams(window.location.search);
            const eventIdFromUrl = urlParams.get('eventId');

            fetch(`@Url.Action("GetVolunteerData", "Events")?regId=${currentRegId}&eventId=${eventIdFromUrl}`)
                .then(res => {
                    if (!res.ok) return res.json().then(err => { throw new Error(err.message) });
                    return res.json();
                })
                .then(data => {
                    document.getElementById('volunteer-name').innerText = data.name;
                    document.getElementById('scan-result').style.display = 'block';

                    currentRegId = data.regId;

                    scanner.clear(); 
                })
                .catch(err => {
                    alert("خطأ: " + err.message);
                });
        }
    });

    document.getElementById('confirm-btn').addEventListener('click', () => {
        fetch('@Url.Action("ConfirmAttendance", "Events")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ regId: currentRegId })
        })
        .then(res => res.json())
        .then(data => {
            alert(data.message);
            location.reload();
        })
        .catch(err => alert("حدث خطأ أثناء تأكيد الحضور"));
    });
</script>