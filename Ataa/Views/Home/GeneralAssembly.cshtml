@model dynamic
@{
    Layout = "~/Views/Shared/_homeLayout1.cshtml";

}

<style>
    .sidebar, #sidebar-wrapper, .main-sidebar, .sidebar-container, .nav-sidebar {
        display: none !important;
    }

    .main-wrapper, .content-wrapper, #page-content-wrapper, main {
        margin-right: 0 !important;
        margin-left: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .assembly-container {
        background-color: #f8faf7;
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        padding-bottom: 60px;
        font-family: 'Segoe UI', sans-serif;
    }

    .page-watermark {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 85%;
        opacity: 0.05;
        z-index: 1;
        pointer-events: none;
    }

    .custom-table-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        overflow: hidden;
        border: 1px solid #eef2ed;
        position: relative;
        z-index: 5;
        margin-bottom: 40px;
    }

    .table thead {
        background: #2d4d22;
        color: white;
    }

        .table thead th {
            padding: 20px;
            border: none;
            font-weight: 700;
            text-align: right;
        }

    .table tbody tr {
        transition: 0.3s;
    }

        .table tbody tr:hover {
            background-color: #f1f5f0;
        }

    .table td {
        padding: 15px 20px;
        vertical-align: middle;
        border-bottom: 1px solid #f0f0f0;
        color: #444;
        text-align: right;
    }

    .attachment-box {
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 15px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 350px;
        margin-bottom: 30px;
        transition: 0.3s;
        text-decoration: none !important;
        position: relative;
        z-index: 10;
    }

        .attachment-box:hover {
            border-color: #d4af37;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

    .pdf-icon {
        background: #fdf2f2;
        color: #dc3545;
        width: 45px;
        height: 45px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

</style>

