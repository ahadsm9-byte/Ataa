@model IEnumerable<Ataa.Models.Events>


<style>
    .archive-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
        padding: 20px;
    }

    .success-card {
        background: white;
        border: 1.5px solid #c5d9c0;
        border-radius: 20px;
        overflow: hidden;
        transition: 0.3s;
        cursor: pointer;
        text-decoration: none !important;
        display: block;
    }

        .success-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 20px rgba(45, 77, 34, 0.1);
        }

    .card-img-container {
        height: 200px;
        position: relative;
    }

        .card-img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .card-info {
        padding: 15px;
        text-align: center;
    }

        .card-info h5 {
            color: #2d4d22;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .card-info span {
            color: #888;
            font-size: 0.85rem;
        }

    .go-btn {
        background: #2d4d22;
        color: white;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 10px auto;
        transition: 0.3s;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        padding: 0 20px;
    }

    .btn-send-all {
        background: #d9534f;
        color: white;
        border: none;
        padding: 10px 25px;
        border-radius: 30px;
        font-weight: bold;
        transition: 0.3s;
    }

        .btn-send-all:hover {
            background: #c9302c;
            transform: scale(1.05);
            color: white;
        }

    .vol-list-box {
        max-height: 250px;
        overflow-y: auto;
        background: #f8fcf8;
        border-radius: 12px;
        padding: 10px;
        border: 1px solid #eee;
    }

    .vol-item {
        background: white;
        padding: 8px 12px;
        margin-bottom: 5px;
        border-radius: 8px;
        font-size: 0.9rem;
        border-right: 3px solid #2d4d22;
    }
</style>

<div class="container mt-5" dir="rtl">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-pill border-0 shadow-sm mb-4 px-4 text-center">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
        </div>
    }

    <div class="top-bar">
        <h2 class="fw-bold m-0" style="color: #2d4d22;">مركز الإشعارات</h2>
        <button class="btn btn-send-all shadow" data-bs-toggle="modal" data-bs-target="#notifAllModal">
            <i class="fas fa-bullhorn ms-2"></i> إرسال إشعار للكل
        </button>
    </div>

    <div class="archive-grid">
        @foreach (var item in Model)
        {
            <div class="success-card shadow-sm" onclick="openEventModal(@item.Id, '@item.Name')">
                <div class="card-img-container">
                    <img src="@item.Image" onerror="this.src='/images/default.jpg'">
                </div>
                <div class="card-info">
                    <h5>@item.Name</h5>
                    <span>@item.Date.ToString("yyyy/MM/dd")</span>
                    <div class="go-btn">
                        <i class="fas fa-paper-plane"></i>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="notifAllModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 25px;">
            <form asp-action="SendToAll" method="post">
                <div class="modal-header border-0 pb-0 pt-4 px-4">
                    <h5 class="fw-bold text-danger">إرسال تنبيه لجميع المتطوعين</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">سيصل هذا الإشعار إلى كافة المسجلين في النظام.</p>
                    <textarea name="message" class="form-control rounded-4 shadow-sm" rows="5" placeholder="اكتب نص الرسالة هنا..." required></textarea>
                </div>
                <div class="modal-footer border-0 p-4">
                    <button type="submit" class="btn btn-danger w-100 rounded-pill py-2 fw-bold">إرسال للكل الآن</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="eventModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow" style="border-radius: 25px;">
            <form asp-action="SendToEventVolunteers" method="post">
                <input type="hidden" name="eventId" id="modalEventId" />
                <div class="modal-header border-0 pb-0 pt-4 px-4">
                    <h5 class="fw-bold" id="modalEventName" style="color: #2d4d22;"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row">
                        <div class="col-md-7 border-start">
                            <label class="fw-bold mb-2 small text-muted">نص الإشعار:</label>
                            <textarea name="message" class="form-control rounded-4 shadow-sm" rows="7" placeholder="ماذا تريد أن ترسل للمتطوعين؟" required></textarea>
                        </div>
                        <div class="col-md-5">
                            <label class="fw-bold mb-2 small text-muted">المتطوعون المسجلون:</label>
                            <div id="volsList" class="vol-list-box">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4">
                    <button type="submit" class="btn btn-success w-100 rounded-pill py-2 fw-bold" style="background: #2d4d22;">إرسال لهؤلاء المتطوعين</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openEventModal(eventId, eventName) {
        document.getElementById('modalEventId').value = eventId;
        document.getElementById('modalEventName').innerText = "فعالية: " + eventName;
        document.getElementById('volsList').innerHTML = "<p class='text-center p-4'><i class='fas fa-sync fa-spin'></i> جاري جلب الأسماء...</p>";

        var modalElement = document.getElementById('eventModal');
        var myModal = bootstrap.Modal.getOrCreateInstance(modalElement);
        myModal.show();

        fetch('/Events/GetVolunteersForEvent?eventId=' + eventId)
            .then(res => res.text())
            .then(html => {
                document.getElementById('volsList').innerHTML = html;
            })
            .catch(err => {
                document.getElementById('volsList').innerHTML = "<p class='text-danger'>حدث خطأ في تحميل البيانات</p>";
            });
    }
</script>