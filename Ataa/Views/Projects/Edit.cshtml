@model Ataa.Models.Projects

@{
    ViewData["Title"] = "تعديل المشروع";
}

<div class="container mt-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-primary text-white py-3 rounded-top-4">
                    <h4 class="mb-0 text-center"><i class="bi bi-pencil-square"></i> تعديل بيانات مشروع: @Model.Name</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2" role="alert"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CompletionPercentage" />
                        <input type="hidden" asp-for="Image" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label fw-bold">اسم المشروع</label>
                                <input asp-for="Name" class="form-control rounded-pill border-primary" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="OrganizingEntity" class="form-label fw-bold">الجهة المنظمة</label>
                                <input asp-for="OrganizingEntity" class="form-control rounded-pill border-primary" />
                                <span asp-validation-for="OrganizingEntity" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12 mb-3">
                                <label asp-for="Description" class="form-label fw-bold">وصف المشروع</label>
                                <textarea asp-for="Description" class="form-control rounded-4 border-primary" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="TargetAmount" class="form-label fw-bold">المبلغ المستهدف</label>
                                <div class="input-group">
                                    <input asp-for="TargetAmount" class="form-control rounded-start-pill border-primary" />
                                    <span class="input-group-text bg-light border-primary rounded-end-pill">ريال</span>
                                </div>
                                <span asp-validation-for="TargetAmount" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="CurrentAmount" class="form-label fw-bold">المبلغ المجموع حالياً</label>
                                <div class="input-group">
                                    <input asp-for="CurrentAmount" class="form-control rounded-start-pill border-primary" />
                                    <span class="input-group-text bg-light border-primary rounded-end-pill">ريال</span>
                                </div>
                                <span asp-validation-for="CurrentAmount" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Date" class="form-label fw-bold">تاريخ البداية</label>
                                <input asp-for="Date" class="form-control rounded-pill border-primary" />
                                <span asp-validation-for="Date" class="text-danger small"></span>
                                </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="ImageFile" class="form-label fw-bold">تغيير صورة المشروع</label>
                                <input asp-for="ImageFile" type="file" class="form-control rounded-pill border-primary" accept="image/*" />
                                <div class="form-text text-muted small">اتركه فارغاً للاحتفاظ بالصورة الحالية.</div>
                                <span asp-validation-for="ImageFile" class="text-danger small"></span>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.Image))
                            {
                                <div class="col-md-12 mb-4 text-center">
                                    <p class="fw-bold small text-muted">الصورة الحالية:</p>
                                    <img src="@Model.Image" class="img-thumbnail rounded-4 shadow-sm" style="max-height: 150px;" alt="Current Project Image" />
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-center border-top pt-4 mt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">إلغاء</a>

                            <div class="d-flex gap-2">
                                <button type="submit" name="submitButton" value="Draft" formnovalidate class="btn btn-outline-secondary rounded-pill px-4">
                                    <i class="bi bi-file-earmark-text"></i> حفظ كمسودة
                                </button>

                                <button type="submit" name="submitButton" value="Published" class="btn btn-success rounded-pill px-4 fw-bold shadow">
                                    <i class="bi bi-megaphone"></i> حفظ ونشر المشروع
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}