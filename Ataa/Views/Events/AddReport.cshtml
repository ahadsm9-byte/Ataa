@model Ataa.Models.Events

<div class="container mt-5" dir="rtl">
    <h2 class="text-center mb-4" style="color: #2d4d22;">تقرير إغلاق الفعالية</h2>
    <div class="card p-4 shadow-sm">
        <form asp-action="SaveReport" method="post" enctype="multipart/form-data">
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="fw-bold">أهداف المبادرة</label>
                    <textarea name="GoalsReport" class="form-control" rows="4" required></textarea>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="fw-bold">آلية التنفيذ والنتائج</label>
                    <textarea name="ExecutionMechanism" class="form-control" rows="4" required></textarea>
                </div>
            </div>

            <div class="mb-4">
                <label class="fw-bold">رفع صور الفعالية (يمكنك اختيار أكثر من صورة)</label>
                <div class="border-dashed p-5 text-center" style="border: 2px dashed #c5d9c0; border-radius: 15px;">
                    <input type="file" name="ExtraImages" multiple class="form-control" accept="image/*" />
                    <i class="bi bi-cloud-upload fs-1 text-success"></i>
                </div>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-success px-5 rounded-pill">نشر التقرير في الأرشيف</button>
            </div>
        </form>
    </div>
</div>
