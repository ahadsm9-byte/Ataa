@model Ataa.Models.Certificates

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>شهادة تطوع - @Model.Registration.Volunteer.Name</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">

    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap');

        body {
            background-color: #f0f2f5;
            font-family: 'Tajawal', 'Segoe UI', sans-serif;
        }

        .cert-container {
            width: 1000px;
            height: 700px;
            padding: 40px;
            background: white;
            margin: 30px auto;
            border: 15px solid #1f6f43;
            position: relative;
            box-shadow: 0 0 30px rgba(0,0,0,0.15);
            box-sizing: border-box;
        }

        .cert-inner {
            border: 2px solid #d4a017;
            height: 100%;
            padding: 40px 50px 160px 50px;
            text-align: center;
            position: relative;
            box-sizing: border-box;
        }

        .cert-header {
            color: #1f6f43;
            font-size: 50px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .cert-title {
            font-size: 24px;
            color: #444;
            margin-bottom: 25px;
            font-weight: 600;
        }

        .volunteer-name {
            font-size: 38px;
            color: #d4a017;
            font-weight: bold;
            margin: 10px 0;
            display: inline-block;
            border-bottom: 2px dashed #d4a017;
            padding: 0 40px;
        }

        .cert-body {
            font-size: 22px;
            line-height: 1.6; 
            color: #333;
            margin-top: 10px;
        }

        .cert-footer {
            position: absolute;
            bottom: 35px; 
            left: 0;
            right: 0;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            padding: 0 80px;
        }

        .signature-box {
            width: 240px;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
        }

        .fixed-img {
            width: 70px;
            height: 70px;
            object-fit: contain;
            margin-bottom: 5px;
        }

        .signature-wrapper {
            position: absolute;
            bottom: 35px; 
            width: 160px;
            height: 80px;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: white; 
            z-index: 2;
        }

        .signature-img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .signature-line {
            width: 100%;
            border-top: 2px solid #d4a017; 
            padding-top: 8px;
            font-weight: bold;
            color: #1f6f43;
            font-size: 16px;
            z-index: 1;
        }

        .label-text {
            font-size: 14px;
            color: #777;
            margin-bottom: 5px;
        }

        @@media print {
            body {
                background: white;
            }

            .cert-container {
                box-shadow: none;
                margin: 0;
                -webkit-print-color-adjust: exact;
            }

            .btn-print {
                display: none;
            }
        }
    </style>
</head>

<body>

    <div class="text-center mt-4 no-print">
        <button onclick="window.print()" class="btn btn-success btn-print px-5 shadow rounded-pill">
            طباعة الشهادة أو حفظ PDF
        </button>
    </div>

    <div class="cert-container">
        <div class="cert-inner">

            <div class="cert-header">شهادة شكر وتقدير</div>

            <div class="cert-title">
                جمعية البيئه بالمدينة المنورة
            </div>

            <div class="cert-body">
                تعتز بتقديم هذه الشهادة للمتطوع/ة:
                <br />
                <div class="volunteer-name">
                    @Model.Registration.Volunteer.Name
                </div>
                <br />
                تقديراً لمشاركته في:
                <br />
                <strong style="color:#1f6f43;">
                    @Model.Registration.Event.Name
                </strong>
                <br />
                بتاريخ <strong>@Model.Registration.Event.Date.ToString("yyyy/MM/dd")</strong>
                بواقع (<strong>@Model.Registration.Event.Hours</strong>) ساعة تطوعية.
            </div>

            <div class="cert-footer">

                <div class="signature-box">
                    <img src="/images/signature.jpg" class="fixed-img" />
                    <span class="label-text">تاريخ الإصدار</span>
                    <div class="signature-line">
                        @Model.IssueDate.ToString("yyyy/MM/dd")
                    </div>
                </div>

                <div class="signature-box">
                    <span class="label-text">اعتماد المشرف</span>

                    @if (!string.IsNullOrEmpty(Model.AddSignature))
                    {
                        <div class="signature-wrapper">
                            <img src="@Model.AddSignature" class="signature-img" />
                        </div>
                    }

                    <div class="signature-line">
                        أ/ @Model.SupervisorName
                    </div>
                </div>

            </div>

        </div>
    </div>

</body>
</html>