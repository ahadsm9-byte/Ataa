@model dynamic
@{
    Layout = "~/Views/Shared/_homeLayout1.cshtml";

}

<style>
    .sidebar, #sidebar-wrapper, .main-sidebar {
        display: none !important;
    }

    .main-wrapper, .content-wrapper, main {
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .partners-bg {
        background: linear-gradient(rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.94)), url('/images/madinah_watermark.jpg');
        background-size: cover;
        background-attachment: fixed;
        min-height: 100vh;
        padding: 60px 15px;
        direction: rtl;
        font-family: 'Segoe UI', Tahoma, sans-serif;
    }

    .header-section {
        text-align: center;
        margin-bottom: 50px;
    }

        .header-section h1 {
            color: #b89146;
            font-weight: 900;
            font-size: 2.8rem;
        }

    .ppt-card {
        background: white;
        border-radius: 25px;
        padding: 50px 30px;
        text-align: center;
        box-shadow: 0 20px 45px rgba(0,0,0,0.08);
        border: 1px solid #e0d0b0;
        max-width: 750px;
        margin: 0 auto 50px;
        transition: 0.4s;
    }

        .ppt-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 25px 50px rgba(184, 145, 70, 0.15);
        }

    .ppt-icon-box {
        width: 110px;
        height: 110px;
        background: #fff5f2;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 25px;
        color: #d24726; 
        font-size: 3.8rem;
        box-shadow: 0 10px 20px rgba(210, 71, 38, 0.1);
    }

    .btn-download-ppt {
        background: #1d4d2b;
        color: white !important;
        padding: 18px 50px;
        border-radius: 50px;
        font-weight: bold;
        text-decoration: none !important;
        display: inline-block;
        transition: 0.3s;
        font-size: 1.3rem;
        border: none;
        box-shadow: 0 8px 15px rgba(29, 77, 43, 0.2);
    }

        .btn-download-ppt:hover {
            background: #2d6b3f;
            transform: scale(1.05);
            box-shadow: 0 12px 20px rgba(29, 77, 43, 0.3);
        }


</style>

<div class="partners-bg">
    <div class="container">

        <div class="header-section">
            <h1>شركاء النجاح</h1>
        </div>

        <div class="ppt-card">
            <div class="ppt-icon-box">
                <i class="fas fa-file-powerpoint"></i>
            </div>
            <h2 style="color: #2d4d22; font-weight: 800; margin-bottom: 15px;">عرض شركاء الجمعية</h2>
            <p style="color: #666; font-size: 1.15rem; margin-bottom: 35px; line-height: 1.7;">
                نعتز بشراكاتنا التي تساهم في تحقيق أهدافنا البيئية.<br>
                يمكنكم تحميل العرض التقديمي للشركاء مباشرة عبر الزر أدناه.
            </p>

            <a href="https://www.madinah-eco.org.sa/uploads/website_pages/1_66cf9ac425705.pptx" class="btn-download-ppt">
                <i class="fas fa-download me-2"></i> تحميل ملف العرض (PPTX)
            </a>
        </div>

     