@model IEnumerable<Ataa.Models.Users>

@{
    ViewData["Title"] = "إدارة الموظفين";
}

<style>
    :root {
        --text-green: #3d5a37;
        --light-bg: #f8faf9;
        --main-green: #2d4d22;
    }

    .main-wrapper {
        padding: 20px;
        padding-bottom: 100px;
    }

    .page-title {
        color: #a3c5a1;
        text-align: center;
        font-size: 2.5rem;
        margin-bottom: 20px;
        font-weight: bold;
    }

    .table-container {
        overflow: visible !important;
        position: relative;
    }

    .employee-table {
        width: 100%;
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border-collapse: separate;
        border-spacing: 0;
    }

        .employee-table th {
            background-color: #fff;
            color: #a3c5a1;
            padding: 15px;
            text-align: center;
        }

        .employee-table td {
            padding: 12px;
            text-align: center;
            color: #777;
            border-top: 1px solid #f1f1f1;
        }

    .btn-submit-custom {
        background-color: var(--main-green);
        color: white;
        border-radius: 25px;
        padding: 10px 30px;
        border: none;
        transition: 0.3s;
    }

        .btn-submit-custom:hover {
            background-color: #3d5a37;
        }

    .email-feedback {
        font-size: 0.85rem;
        margin-top: 5px;
        display: none;
        font-weight: bold;
    }
</style>

<div class="main-wrapper">
    <h1 class="page-title">قائمة الموظفين</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success text-center rounded-pill">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger text-center rounded-pill">@TempData["ErrorMessage"]</div>
    }

    <div class="mb-3 text-start">
        <button type="button" class="btn p-0" data-bs-toggle="modal" data-bs-target="#addEmployeeModal" style="color: var(--text-green); font-weight: bold; border:none; background:none;">
            <i class="bi bi-plus-circle-fill ms-1"></i> اضافة موظف
        </button>
    </div>

    <div class="table-container">
        <table class="employee-table">
            <thead>
                <tr>
                    <th style="width: 50px;">الخيارات</th>
                    <th>رقم الموظف</th>
                    <th>الايميل</th>
                    <th>اسم الموظف</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-link text-dark p-0 border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu shadow">
                                        <li>
                                            <a class="dropdown-item" href="javascript:void(0)" onclick="openEditModal('@emp.Id', '@emp.Name', '@emp.Email')">
                                                <i class="bi bi-pencil ms-2 text-primary"></i> تعديل
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item text-danger" href="javascript:void(0)" onclick="openDeleteModal('@emp.Id', '@emp.Name')">
                                                <i class="bi bi-trash ms-2"></i> حذف
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                            <td>@emp.Id</td>
                            <td>@emp.Email</td>
                            <td>@emp.Name</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="addEmployeeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0" style="border-radius: 20px;">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" style="color: var(--main-green);">إضافة موظف جديد</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/Users/AddEmployee" method="post">
                <input type="hidden" name="Role" value="employee" />
                <div class="modal-body px-4">
                    <div class="mb-3 text-end">
                        <label class="form-label fw-bold">اسم الموظف</label>
                        <input type="text" name="Name" class="form-control rounded-pill shadow-sm" required>
                    </div>
                    <div class="mb-3 text-end">
                        <label class="form-label fw-bold">الايميل</label>
                        <input type="email" name="Email" id="AddEmail" class="form-control rounded-pill shadow-sm" required>
                        <div id="emailError" class="email-feedback text-danger">⚠️ هذا الايميل مسجل مسبقاً!</div>
                    </div>
                    <div class="mb-3 text-end">
                        <label class="form-label fw-bold">الرقم السري</label>
                        <input type="password" name="Password" class="form-control rounded-pill shadow-sm" required>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button type="submit" id="submitBtn" class="btn btn-submit-custom shadow-sm">إضافة موظف</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editEmployeeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0" style="border-radius: 20px;">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">تعديل بيانات الموظف</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editEmployeeForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="edit-id" />
                <div class="modal-body px-4">
                    <div class="mb-3 text-end">
                        <label class="form-label fw-bold">الاسم</label>
                        <input type="text" name="Name" id="edit-name" class="form-control rounded-pill shadow-sm" required>
                    </div>
                    <div class="mb-3 text-end">
                        <label class="form-label fw-bold">الايميل</label>
                        <input type="email" name="Email" id="edit-email" class="form-control rounded-pill shadow-sm" required>
                    </div>
                    <div class="mb-3 text-end">
                        <label class="form-label fw-bold">كلمة المرور الجديدة</label>
                        <input type="password" name="Password" class="form-control rounded-pill shadow-sm" placeholder="اختياري">
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button type="submit" class="btn btn-submit-custom shadow-sm">حفظ التغييرات</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <div class="modal-body text-center p-4">
                <i class="bi bi-exclamation-circle text-danger" style="font-size: 3rem;"></i>
                <h5 class="mt-2 fw-bold">تأكيد الحذف</h5>
                <p class="text-muted">هل أنت متأكد من حذف <span id="del-name" class="fw-bold"></span>؟</p>
                <form id="del-form" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="del-id" />
                    <div class="d-flex justify-content-center gap-2 mt-3">
                        <button type="submit" class="btn btn-danger rounded-pill px-4">حذف</button>
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('AddEmail').addEventListener('blur', function () {
            const email = this.value;
            const emailInput = this;
            const errorMsg = document.getElementById('emailError');
            const submitBtn = document.getElementById('submitBtn');

            if (email.trim() === "") return;

            fetch('/Users/CheckEmailExists?email=' + encodeURIComponent(email))
                .then(response => response.json())
                .then(exists => {
                    if (exists) {
                        emailInput.style.borderColor = "red";
                        emailInput.style.boxShadow = "0 0 5px rgba(255,0,0,0.5)";
                        errorMsg.style.display = "block";
                        submitBtn.disabled = true;
                    } else {
                        emailInput.style.borderColor = "#ced4da";
                        emailInput.style.boxShadow = "none";
                        errorMsg.style.display = "none";
                        submitBtn.disabled = false;
                    }
                });
        });

        function openEditModal(id, name, email) {
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-name').value = name;
            document.getElementById('edit-email').value = email;
            new bootstrap.Modal(document.getElementById('editEmployeeModal')).show();
        }

        document.getElementById('editEmployeeForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const formData = new FormData(this);
            fetch('/Users/EditEmployee', {
                method: 'POST',
                body: formData,
                headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }
            }).then(res => res.ok ? location.reload() : alert('خطأ في التعديل'));
        });

        function openDeleteModal(id, name) {
            document.getElementById('del-id').value = id;
            document.getElementById('del-name').innerText = name;
            document.getElementById('del-form').action = '/Users/DeleteConfirmed/' + id;
            new bootstrap.Modal(document.getElementById('deleteConfirmModal')).show();
        }
    </script>
}