@model IEnumerable<Ataa.Models.Projects>

@{
    Layout = "~/Views/Shared/_homeLayout1.cshtml";
    ViewData["Title"] = "الرئيسية - متبرع";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - عطاء</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary-green: #2D4F28;
            --light-green: #5c8b4f;
            --bg-soft: #f4f7f4;
        }

        body {
            background-color: var(--bg-soft);
            font-family: 'Segoe UI', Tahoma, sans-serif;
        }

        .main-carousel .carousel-item img {
            height: 400px;
            object-fit: cover;
            border-radius: 0 0 40px 40px;
        }

        .donation-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            transition: transform 0.3s;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .progress-container {
            background-color: #E9ECEF;
            height: 25px;
            border-radius: 50px;
            margin: 15px 0;
            overflow: hidden;
        }

        .progress-bar-fill {
            background-color: #d4e3d1;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary-green);
            font-weight: bold;
            font-size: 12px;
            width: 0%;
            transition: width 1.5s ease-in-out;
        }

        .amounts-box {
            display: flex;
            justify-content: space-between;
            background: #F8F9FA;
            padding: 10px 15px;
            border-radius: 12px;
            margin-bottom: 15px;
        }

        .status-toggle span {
            padding: 5px 20px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 14px;
            background: #eee;
            transition: 0.3s;
        }

        .status-toggle .active-status {
            background-color: var(--primary-green);
            color: white;
        }

        .stat-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            border-bottom: 4px solid var(--primary-green);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
        }

            .stat-card:hover {
                transform: translateY(-10px) scale(1.05);
                box-shadow: 0 12px 25px rgba(0,0,0,0.12);
            }

        .stat-number {
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--primary-green);
            display: block;
        }

        .fast-amount {
            transition: all 0.2s;
            border: 2px solid var(--primary-green) !important;
            color: var(--primary-green);
        }

            .fast-amount:hover {
                background-color: var(--primary-green);
                color: white;
            }
    </style>
</head>
<body>

    <div id="mainHeroCarousel" class="carousel slide main-carousel mb-5" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="/images/donor1.jpeg" class="d-block w-100" alt="سلايد 1">
            </div>
            <div class="carousel-item">
                <img src="/images/donor.png" class="d-block w-100" alt="سلايد 2">
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#mainHeroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#mainHeroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
        </button>
    </div>

    <div class="container py-5">
        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-number">@ViewBag.DonationsOpsCount</div>
                    <div class="text-muted fw-bold">إجمالي المشاريع</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-number">@(((double)(ViewBag.TotalDonationsAmount ?? 0)).ToString("N0"))</div>
                    <div class="text-muted fw-bold">إجمالي التبرعات (ريال)</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-number">@ViewBag.BeneficiariesCount</div>
                    <div class="text-muted fw-bold">المستفيدين</div>
                </div>
            </div>
        </div>
    </div>

    <div class="container mb-4">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="fw-bold" style="color: var(--primary-green);">التبرعات</h2>
                <hr style="width: 100px; margin: 10px auto; border: 2px solid var(--primary-green); opacity: 1;">
            </div>
        </div>
    </div>

    <div class="container mb-5">
        <div class="row g-3 justify-content-center align-items-center">
            <div class="col-md-5">
                <div class="search-box position-relative">
                    <input type="text" id="projectSearchInput" class="form-control" placeholder="ابحث عن مشروع بالاسم..." style="border: 2px solid var(--primary-green); border-radius: 25px; padding-right: 40px;">
                    <i class="fa-solid fa-magnifying-glass position-absolute" style="right: 15px; top: 12px; color: #ccc;"></i>
                </div>
            </div>
            <div class="col-md-4">
                <div class="status-toggle d-flex gap-2 justify-content-center">
                    <span class="active-status" id="btnAll" onclick="filterProjects('all')">الكل</span>
                    <span id="btnActive" onclick="filterProjects('active')">قائمة</span>
                    <span id="btnCompleted" onclick="filterProjects('completed')">مكتملة</span>
                </div>
            </div>
        </div>
    </div>

    <div class="container py-3">
        <div class="row g-4" id="projectsGrid">
            @foreach (var item in Model)
            {
                var percentage = item.TargetAmount > 0 ? ((double)item.CurrentAmount / (double)item.TargetAmount) * 100 : 0;
                if (percentage > 100) percentage = 100;
                var remaining = item.TargetAmount - item.CurrentAmount;

                <div class="col-md-4 project-card-container" data-status="@(percentage >= 100 ? "completed" : "active")">
                    <div class="donation-card shadow-sm">
                        <img src="@item.Image" class="w-100" style="height: 200px; object-fit: cover;" onerror="this.src='/images/Logo.jpg'">

                        <div class="p-4 text-end d-flex flex-column flex-grow-1">
                            <h5 class="fw-bold mb-3 project-name" style="color: var(--primary-green);">@item.Name</h5>

                            <div class="progress-container">
                                <div class="progress-bar-fill" data-progress="@percentage">
                                    @Math.Round(percentage)%
                                </div>
                            </div>

                            <div class="amounts-box">
                                <div class="text-start">
                                    <small class="text-muted d-block">جمعت</small>
                                    <span class="fw-bold text-success">@item.CurrentAmount.ToString("N0") ريال</span>
                                </div>
                                <div class="text-end">
                                    <small class="text-muted d-block">المتبقي</small>
                                    <span class="fw-bold">@(remaining > 0 ? remaining.ToString("N0") : "0") ريال</span>
                                </div>
                            </div>

                            @if (percentage >= 100 && remaining <= 0)
                            {
                                <button class="btn btn-secondary w-100 rounded-pill disabled" disabled>
                                    <i class="fa-solid fa-check-double me-1"></i> مكتمل
                                </button>
                            }
                            else
                            {
                                <a href="javascript:void(0)"
                                   onclick="openDonationModal('@item.Id', '@item.Name', '@item.Image', @remaining)"
                                   class="btn btn-outline-success w-100 rounded-pill">
                                    تبرع الآن
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-pill px-3 mt-2 text-center">تفاصيل</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="modal fade" id="donationModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 25px;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark text-center w-100 mt-2">
                        دعم مشروع: <span id="projectNameLabel"></span>
                    </h5>
                    <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4 text-center">
                    <input type="hidden" id="modalProjectId">
                    <input type="hidden" id="modalProjectImage">

                    <label class="small text-muted mb-3 d-block text-end">اختر قيمة التبرع</label>
                    <div class="d-flex justify-content-center gap-2 mb-4">
                        <button type="button" class="btn btn-outline-success rounded-pill px-4 py-2 fast-amount fw-bold" data-val="100">100 ريال</button>
                        <button type="button" class="btn btn-outline-success rounded-pill px-4 py-2 fast-amount fw-bold" data-val="50">50 ريال</button>
                        <button type="button" class="btn btn-outline-success rounded-pill px-4 py-2 fast-amount fw-bold" data-val="10">10 ريال</button>
                    </div>

                    <div class="mb-3">
                        <label class="small text-muted mb-2 d-block text-end">أو أدخل مبلغاً آخر</label>
                        <div class="input-group mb-1 shadow-sm rounded-pill overflow-hidden border">
                            <span class="input-group-text bg-white border-0 text-muted">ريال</span>
                            <input type="number" id="modalAmount" class="form-control border-0 text-center fw-bold fs-5" placeholder="0.00">
                        </div>
                        <div id="remainingNotice" class="text-danger small fw-bold mt-2 text-end"></div>
                    </div>

                    <div class="mt-4">
                        <button type="button" onclick="handleAddToCart()" class="btn btn-success w-100 rounded-pill py-3 fw-bold fs-5 shadow-sm">
                            إضافة إلى السلة <i class="fa-solid fa-cart-plus ms-2"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function openDonationModal(id, name, image, remaining) {
            $('#modalProjectId').val(id);
            $('#modalProjectImage').val(image);
            $('#projectNameLabel').text(name);
            var amountInput = $('#modalAmount');
            amountInput.attr('max', remaining);
            amountInput.val('');
            $('.fast-amount').removeClass('btn-success text-white').addClass('btn-outline-success');
            $('#remainingNotice').text('المبلغ المتبقي للاكتمال: ' + remaining + ' ريال');
            var modalEl = document.getElementById('donationModal');
            var myModal = new bootstrap.Modal(modalEl);
            myModal.show();
        }

        function handleAddToCart() {
            const amountInput = $('#modalAmount');
            const amount = parseFloat(amountInput.val());
            const maxRemaining = parseFloat(amountInput.attr('max'));

            if (!amount || amount <= 0) {
                Swal.fire('تنبيه', 'يرجى إدخال مبلغ صحيح', 'warning');
                return;
            }

            if (amount > maxRemaining) {
                Swal.fire({
                    title: 'مبلغ زائد!',
                    text: 'المبلغ المتبقي هو ' + maxRemaining + ' ريال. هل تريد التبرع بالمتبقي؟',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'نعم، تبرع بـ ' + maxRemaining,
                    cancelButtonText: 'إلغاء'
                }).then((result) => { if (result.isConfirmed) executeAddition(maxRemaining); });
                return;
            }
            executeAddition(amount);
        }

        function executeAddition(finalAmount) {
            const item = {
                id: $('#modalProjectId').val(),
                name: $('#projectNameLabel').text(),
                amount: finalAmount,
                image: $('#modalProjectImage').val()
            };

            let cart = JSON.parse(localStorage.getItem('cartItems')) || [];
            cart.push(item);
            localStorage.setItem('cartItems', JSON.stringify(cart));

            bootstrap.Modal.getInstance(document.getElementById('donationModal')).hide();

            if (typeof updateGlobalCartCount === "function") {
                updateGlobalCartCount();
            }

            Swal.fire({
                icon: 'success',
                title: 'تمت الإضافة!',
                text: 'تمت إضافة المشروع للسلة بنجاح',
                timer: 1500,
                showConfirmButton: false
            });
        }

        function filterProjects(status) {
            $('.status-toggle span').removeClass('active-status');
            if (status === 'all') $('#btnAll').addClass('active-status');
            else if (status === 'active') $('#btnActive').addClass('active-status');
            else $('#btnCompleted').addClass('active-status');

            $('.project-card-container').each(function () {
                var cardStatus = $(this).data('status');
                if (status === 'all' || cardStatus === status) $(this).fadeIn();
                else $(this).fadeOut();
            });
        }

        $(document).ready(function () {
            $('.fast-amount').click(function () {
                let val = parseFloat($(this).data('val'));
                let max = parseFloat($('#modalAmount').attr('max'));
                $('#modalAmount').val(val > max ? max : val);
                $('.fast-amount').removeClass('btn-success text-white').addClass('btn-outline-success');
                $(this).removeClass('btn-outline-success').addClass('btn-success text-white');
            });

            $('.progress-bar-fill').each(function () {
                var targetWidth = $(this).data('progress');
                $(this).css('width', targetWidth + '%');
            });

            $('#projectSearchInput').on('keyup', function () {var value = $(this).val().toLowerCase();
                $("#projectsGrid .project-card-container").filter(function () {
                    $(this).toggle($(this).find('.project-name').text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
</body>
</html>
