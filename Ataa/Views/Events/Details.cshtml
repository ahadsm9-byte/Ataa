@model Ataa.Models.Events

@{
    ViewData["Title"] = "تفاصيل الفعالية";
    Layout = "~/Views/Shared/_homeLayout1.cshtml";
}

<style>
    .details-container {
        background: white;
        padding: 40px;
        border-radius: 25px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        max-width: 950px;
        margin: 30px auto;
        direction: rtl;
    }

    .event-header {
        display: flex;
        align-items: center;
        gap: 30px;
        margin-bottom: 40px;
        border-bottom: 2px solid #f0f4f0;
        padding-bottom: 30px;
    }

    .event-main-img {
        width: 250px;
        height: 250px;
        object-fit: cover;
        border-radius: 25px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    }

    .event-title-info h1 {
        color: #2d4d22;
        font-weight: 800;
        font-size: 2rem;
        margin-bottom: 10px;
    }

    .status-badge {
        padding: 6px 18px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: bold;
        display: inline-block;
        margin-bottom: 15px;
    }

    .status-active {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .status-closed {
        background: #ffebee;
        color: #c62828;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .info-item {
        background: #fcfdfc;
        padding: 18px;
        border-radius: 15px;
        border: 1px solid #f0f0f0;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .info-icon {
        background: #2d4d22;
        color: white;
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .info-content .info-label {
        font-size: 0.85rem;
        color: #888;
        font-weight: bold;
    }

    .info-content .info-value {
        font-size: 1rem;
        color: #333;
        font-weight: 600;
    }

    .full-width-box {
        grid-column: span 2;
        margin-top: 10px;
    }

    .description-card {
        background: #f9fbf9;
        padding: 25px;
        border-radius: 20px;
        border-right: 4px solid #5c8b4f;
    }

    .description-text {
        line-height: 1.8;
        color: #444;
        white-space: pre-line;
    }

    .registration-section {
        margin-top: 40px;
    }

    .qr-box {
        background: #f9fbf9;
        border: 2px dashed #2d4d22;
        padding: 30px;
        border-radius: 20px;
        transition: 0.3s;
    }

    .action-group {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-top: 20px;
        flex-wrap: wrap;
    }

    .btn-cancel {
        background: white;
        color: #dc3545;
        border: 1px solid #dc3545;
        padding: 10px 25px;
        border-radius: 25px;
        font-weight: bold;
        transition: 0.3s;
        cursor: pointer;
    }

        .btn-cancel:hover {
            background: #fff5f5;
        }

    .alert-full {
        background: #fff3cd;
        color: #856404;
        padding: 20px;
        border-radius: 15px;
        border: 1px solid #ffeeba;
        font-weight: bold;
        display: block;
        margin: 20px 0;
    }
</style>

<div class="details-container">
    <div class="event-header">
        <img src="@(string.IsNullOrEmpty(Model.Image) ? "/images/default.jpg" : Model.Image)" class="event-main-img" />
        <div class="event-title-info">
            @{
                bool isEventOpen = (Model.Status == "open" || Model.Status == "Active");
                bool isEventFull = (ViewBag.IsFull == true);
            }

            @if (isEventOpen && !isEventFull)
            {
                <span class="status-badge status-active"><i class="fas fa-check-circle"></i> متاحة للتقديم</span>
            }
            else if (isEventFull && isEventOpen)
            {
                <span class="status-badge status-closed" style="background: #fff3cd; color: #856404;"><i class="fas fa-users"></i> المقاعد مكتملة</span>
            }
            else
            {
                <span class="status-badge status-closed"><i class="fas fa-times-circle"></i> مغلقة حالياً</span>
            }

            <h1>@Model.Name</h1>
            <p style="color: #5c8b4f; font-weight: bold;">
                <i class="fas fa-bookmark"></i> المجال: @Model.Category
            </p>
        </div>
    </div>

    <div class="info-grid">
        <div class="info-item">
            <div class="info-icon"><i class="fas fa-calendar-day"></i></div>
            <div class="info-content">
                <div class="info-label">تاريخ ووقت الفعالية</div>
                <div class="info-value">@Model.Date.ToString("dd MMMM yyyy - hh:mm tt")</div>
            </div>
        </div>

        <div class="info-item">
            <div class="info-icon"><i class="fas fa-map-marker-alt"></i></div>
            <div class="info-content">
                <div class="info-label">المكان</div>
                <div class="info-value">@Model.Location</div>
            </div>
        </div>

        <div class="info-item">
            <div class="info-icon"><i class="fas fa-hourglass-half"></i></div>
            <div class="info-content">
                <div class="info-label">الساعات المكتسبة</div>
                <div class="info-value">@Model.Hours ساعات</div>
            </div>
        </div>

        <div class="info-item">
            <div class="info-icon"><i class="fas fa-user-friends"></i></div>
            <div class="info-content">
                <div class="info-label">الطاقة الاستيعابية</div>
                <div class="info-value">@Model.Capacity متطوع</div>
            </div>
        </div>

        <div class="info-item full-width-box">
            <div class="info-icon"><i class="fas fa-building"></i></div>
            <div class="info-content">
                <div class="info-label">الجهة المنظمة</div>
                <div class="info-value">@Model.OrganizingEntity</div>
            </div>
        </div>

        <div class="full-width-box">
            <div class="description-card">
                <h5 style="color: #2d4d22; margin-bottom: 15px; font-weight: bold;">
                    <i class="fas fa-info-circle"></i> تفاصيل ومميزات الفعالية
                </h5>
                <div class="description-text">@Model.Description</div>
            </div>
        </div>
    </div>

    <div class="registration-section text-center">
        @if (ViewBag.IsRegistered == true)
        {
            <div class="qr-box">
                <h4 style="color: #2d4d22; font-weight: bold;">أنت مسجل في هذه الفعالية!</h4>
                <p>تم حفظ مقعدك بنجاح، ننتظرك في الموعد المكتوب أعلاه.</p>

                <img src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=@ViewBag.RegId"
                     style="background: white; padding: 10px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);" />

                <div class="action-group">
                    <form asp-action="CancelRegistration" method="post" onsubmit="return confirm('هل أنت متأكد من إلغاء التسجيل؟')">
                        <input type="hidden" name="regId" value="@ViewBag.RegId" />
                        <button type="submit" class="btn-cancel">
                            <i class="fas fa-user-minus"></i> إلغاء الاشتراك
                        </button>
                    </form>
                </div>
                <p class="mt-3" style="font-size: 0.8rem; color: #999;">رقم التسجيل: #@ViewBag.RegId</p>
            </div>
        }
        else
        {

            @if (Model.Status != "open" && Model.Status != "Active")
            {
                <div class="alert-full" style="background: #f8d7da; color: #721c24; border-color: #f5c6cb;">
                    <i class="fas fa-lock"></i> نعتذر، التسجيل في هذه الفعالية مغلق حالياً.
                </div>
            }
            else if (ViewBag.IsFull == true)
            {
                <div class="alert-full">
                    <i class="fas fa-users-slash"></i> نعتذر منك، اكتمل عدد المتطوعين لهذه الفعالية.
                </div>
            }
            else
            {
                <div class="apply-box" style="background: #f8f9fa; padding: 30px; border-radius: 20px;">
                    <h4 class="mb-4">هل ترغب في الانضمام لهذه الفعالية؟</h4>
                    <form asp-action="Register" method="post">
                        <input type="hidden" name="eventId" value="@Model.Id" />
                        <button type="submit" class="btn" style="background: #2d4d22; color: white; padding: 12px 60px; border-radius: 30px; font-weight: bold; border: none; font-size: 1.1rem; cursor: pointer;">
                            <i class="fas fa-user-plus"></i> تسجيل الآن
                        </button>
                    </form>
                </div>
            }
        }
    </div>
</div>