@model dynamic
@{
    Layout = "~/Views/Shared/_homeLayout1.cshtml";

}

<style>
    .sidebar, #sidebar-wrapper, .main-sidebar {
        display: none !important;
    }

    .main-wrapper, .content-wrapper, main {
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .reg-bg {
        background: linear-gradient(rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.98)), url('/images/madinah_watermark.jpg');
        background-size: cover;
        background-attachment: fixed;
        min-height: 100vh;
        padding: 60px 15px;
        direction: rtl;
        font-family: 'Segoe UI', Tahoma, sans-serif;
    }

    .header-section {
        text-align: center;
        margin-bottom: 50px;
    }

        .header-section h1 {
            color: #b89146;
            font-weight: 800;
            font-size: 2.5rem;
            position: relative;
            padding-bottom: 15px;
        }

            .header-section h1::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 50%;
                transform: translateX(-50%);
                width: 100px;
                height: 3px;
                background-color: #1d4d2b;
            }

    .file-card {
        background: white;
        border-radius: 20px;
        padding: 30px 20px;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        border-top: 6px solid #1d4d2b; 
        transition: 0.3s ease;
    }

        .file-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 35px rgba(29, 77, 43, 0.15);
        }

    .file-icon-box {
        color: #b89146;
        font-size: 3.5rem;
        margin-bottom: 20px;
    }

    .file-title {
        color: #1d4d2b;
        font-weight: 700;
        font-size: 1.1rem;
        line-height: 1.6;
        margin-bottom: 15px;
        text-align: center;
        min-height: 3.5rem;
        display: flex;
        align-items: center;
    }

    .file-info {
        font-size: 0.85rem;
        color: #777;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .btn-view-pdf {
        background: #1d4d2b;
        color: white !important;
        width: 100%;
        text-align: center;
        padding: 12px;
        border-radius: 25px; 
        text-decoration: none !important;
        font-weight: 600;
        font-size: 0.95rem;
        transition: 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-view-pdf:hover {
            background: #b89146;
        }

</style>

<div class="reg-bg">
    <div class="container">
        <div class="header-section">
            <h1>اللوائح والسياسات</h1>
